{
  "name": "web-worksheet-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"server/**/*.test.mjs\"",
    "test:ci-runner": "node --test scripts/ci/*.test.mjs",
    "test:browser": "node scripts/ci/run-browser-smokes.mjs",
    "test:postgres": "node scripts/review-fixes-postgres.mjs",
    "migrate": "node server/api/db/migrate.js",
    "artifacts:maintain": "node server/api/maintenance/artifacts.js",
    "start:api": "node server/api/server.js",
    "pw:install": "playwright install chromium",
    "serve:static": "node scripts/static-server.mjs",
    "smoke:roleplayscene": "node scripts/roleplayscene-smoke.mjs",
    "smoke:roleplayscene:headed": "node scripts/roleplayscene-smoke.mjs --headed",
    "build:editor": "node scripts/build-rich-text.mjs",
    "check:editor-bundle": "node scripts/build-rich-text.mjs --check"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "esbuild": "0.28.2",
    "playwright": "^1.60.0"
  }
}
