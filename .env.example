# HTTP server
PORT=8787
HOST=127.0.0.1

# PostgreSQL (required)
DATABASE_URL=postgres://worksheet:worksheet@127.0.0.1:5432/worksheet_launcher

# Filesystem root for canonical worksheet ZIP artifacts (required)
STORAGE_ROOT=./var/package-storage

# Max upload size for draft package ZIP bytes (default 30 MB)
# 150 MB example: 157286400
PACKAGE_UPLOAD_MAX_BYTES=31457280

# Trusted Apache-forwarded OIDC headers
AUTH_HEADER_SUB=x-oidc-sub
AUTH_HEADER_EMAIL=x-oidc-email
AUTH_HEADER_NAME=x-oidc-name

# Optional Apache-to-Node shared secret for trusting OIDC headers.
# Configure this only on the API service and inject the same value from Apache.
# Browsers and frontend code must not send this header.
# TRUSTED_PROXY_SECRET=replace-with-long-random-secret
TRUSTED_PROXY_SECRET_HEADER=x-worksheet-proxy-secret
